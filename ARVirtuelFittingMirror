        "Garment:",
        cloth_name
    )
    print("")
    print("Preparing images...")
    print("")
    print("Sending to FASHN...")
    print("")


    try:

        model_image = image_to_base64(
            original_model_path
        )

        garment_image = image_to_base64(
            cloth_path
        )


        result = (
            fashn_client
            .predictions
            .subscribe(

                model_name="tryon-v1.6",

                inputs={

                    "model_image":
                        model_image,

                    "garment_image":
                        garment_image,

                    "category":
                        "tops",

                    "garment_photo_type":
                        "auto",

                    "mode":
                        "performance",

                    "num_samples":
                        1,

                    "output_format":
                        "jpeg"
                }

            )
        )


        print(
            "FASHN STATUS:",
            result.status
        )


        if result.status != "completed":

            print("")
            print("================================")
            print("FASHN FAILED")
            print("================================")
            print("")
            print(result)
            print("")

            processing = False

            return


        output_url = (
            result.output[0]
        )


        print("")
        print("================================")
        print("FASHN SUCCESS!")
        print("================================")
        print("")
        print(
            "Credits used:",
            result.credits_used
        )
        print("")


        # ====================================================
        # SAVE PERMANENTLY
        # ====================================================

        urllib.request.urlretrieve(

            output_url,

            cache_path

        )


        current_result_path = (
            cache_path
        )


        print(
            "RESULT SAVED:"
        )

        print(
            current_result_path
        )

        print("")
        print(
            "CACHED PERMANENTLY."
        )

        print(
            "Next time:"
        )

        print(
            "Credits used: 0"
        )

        print("")


        # ====================================================
        # SHOW RESULT
        # ====================================================

        show_fashn_result(
            current_result_path
        )


        # ====================================================
        # QR
        # ====================================================

        filename = (
            os.path.basename(
                current_result_path
            )
        )


        create_qr(
            filename
        )


        print("")
        print("================================")
        print("TRY-ON COMPLETE")
        print("================================")
        print("")
        print(
            "Press Q or ESC in the "
            "camera/result windows to quit."
        )
        print("")


    except Exception as e:

        print("")
        print("================================")
        print("FASHN ERROR")
        print("================================")
        print("")
        print(e)
        print("")


