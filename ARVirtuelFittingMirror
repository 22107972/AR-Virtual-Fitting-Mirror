def distance(p1, p2):

    return math.sqrt(

        (p1[0] - p2[0]) ** 2

        +

        (p1[1] - p2[1]) ** 2

    )


def prepare_cloth(image):

    if image.shape[2] == 3:

        image = cv2.cvtColor(

            image,

            cv2.COLOR_BGR2BGRA

        )

    alpha = image[:, :, 3]

    coords = cv2.findNonZero(

        (alpha > 10).astype(
            np.uint8
        )

    )

    if coords is not None:

        x, y, w, h = cv2.boundingRect(
            coords
        )

        image = image[
            y:y + h,
            x:x + w
        ]

    return image


def resize_cloth(image, width):

    h, w = image.shape[:2]

    if w <= 0:
        return image

    ratio = width / w

    new_height = int(
        h * ratio
    )

    return cv2.resize(

        image,

        (
            width,
            new_height
        ),

        interpolation=cv2.INTER_AREA

    )


def overlay_transparent(
    background,
    overlay,
    x,
    y
):

    if overlay.shape[2] == 3:

        overlay = cv2.cvtColor(

            overlay,

            cv2.COLOR_BGR2BGRA

        )

    h, w = overlay.shape[:2]

    bg_h, bg_w = background.shape[:2]

    x1 = max(x, 0)

    y1 = max(y, 0)

    x2 = min(
        x + w,
        bg_w
    )

    y2 = min(
        y + h,
        bg_h
    )

    if x1 >= x2 or y1 >= y2:

        return background

    ox1 = x1 - x

    oy1 = y1 - y

    ox2 = ox1 + (x2 - x1)

    oy2 = oy1 + (y2 - y1)

    crop = overlay[
        oy1:oy2,
        ox1:ox2
    ]

    alpha = (
        crop[:, :, 3]
        /
        255.0
    )

    for c in range(3):

        background[
            y1:y2,
            x1:x2,
            c
        ] = (

            alpha * crop[:, :, c]

            +

            (1 - alpha)

            *

            background[
                y1:y2,
                x1:x2,
                c
            ]

        )

    return background


