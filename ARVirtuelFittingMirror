# ============================================================
# MOUSE
# ============================================================

def mouse_callback(

    event,

    x,

    y,

    flags,

    param

):

    global current_cloth

    global show_landmarks

    global take_photo


    if event != cv2.EVENT_LBUTTONDOWN:

        return


    height = window_height

    width = window_width


    # --------------------------------------------------------
    # LAST PHOTO
    # --------------------------------------------------------

    if (

        width // 2 - 110
        <= x
        <=
        width // 2 + 110

        and

        height - 125
        <= y
        <=
        height - 75

    ):

        use_last_photo()

        return


    # --------------------------------------------------------
    # PREVIOUS
    # --------------------------------------------------------

    if (

        20
        <= x
        <=
        220

        and

        height - 125
        <= y
        <=
        height - 75

    ):

        current_cloth -= 1


        if current_cloth < 0:

            current_cloth = (
                len(clothes) - 1
            )


        if original_model_path is not None:

            process_current_cloth()


    # --------------------------------------------------------
    # NEXT
    # --------------------------------------------------------

    elif (

        width - 220
        <= x
        <=
        width - 20

        and

        height - 125
        <= y
        <=
        height - 75

    ):

        current_cloth += 1


        if (
            current_cloth
            >=
            len(clothes)
        ):

            current_cloth = 0


        if original_model_path is not None:

            process_current_cloth()


    # --------------------------------------------------------
    # HIDE TRACKING
    # --------------------------------------------------------

    elif (

        20
        <= x
        <=
        230

        and

        height - 65
        <= y
        <=
        height - 15

    ):

        show_landmarks = (
            not show_landmarks
        )


    # --------------------------------------------------------
    # TAKE PHOTO
    # --------------------------------------------------------

    elif (

        width - 230
        <= x
        <=
        width - 20

        and

        height - 65
        <= y
        <=
        height - 15

    ):

        take_photo = True


