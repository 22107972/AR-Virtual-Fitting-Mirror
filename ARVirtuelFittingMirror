# ============================================================
# MAIN LOOP
# ============================================================

while True:

    ret, raw_frame = cap.read()


    if not ret:

        break


    # --------------------------------------------------------
    # IMPORTANT
    #
    # Keep raw frame for FASHN.
    # Display remains mirrored.
    # --------------------------------------------------------

    model_photo = (
        raw_frame.copy()
    )


    frame = cv2.flip(
        raw_frame,
        1
    )


    window_height, window_width = (
        frame.shape[:2]
    )


    # ========================================================
    # MEDIAPIPE
    # ========================================================

    rgb = cv2.cvtColor(
        frame,
        cv2.COLOR_BGR2RGB
    )


    results = pose.process(
        rgb
    )


    # ========================================================
    # LIVE AR PREVIEW
    # ========================================================

    if results.pose_landmarks:

        landmarks = (
            results.pose_landmarks.landmark
        )


        left_shoulder = landmarks[
            mp_pose.PoseLandmark.LEFT_SHOULDER.value
        ]

        right_shoulder = landmarks[
            mp_pose.PoseLandmark.RIGHT_SHOULDER.value
        ]

        left_ear = landmarks[
            mp_pose.PoseLandmark.LEFT_EAR.value
        ]

        right_ear = landmarks[
            mp_pose.PoseLandmark.RIGHT_EAR.value
        ]


        if (

            left_shoulder.visibility
            > 0.5

            and

            right_shoulder.visibility
            > 0.5

        ):

            left_point = (

                int(
                    left_shoulder.x
                    * window_width
                ),

                int(
                    left_shoulder.y
                    * window_height
                )

            )


            right_point = (

                int(
                    right_shoulder.x
                    * window_width
                ),

                int(
                    right_shoulder.y
                    * window_height
                )

            )


            shoulder_center = (

                int(

                    (
                        left_point[0]
                        +
                        right_point[0]
                    )
                    /
                    2

                ),

                int(

                    (
                        left_point[1]
                        +
                        right_point[1]
                    )
                    /
                    2

                )

            )


            shoulder_width = distance(

                left_point,

                right_point

            )


            # ------------------------------------------------
            # NECK
            # ------------------------------------------------

            if (

                left_ear.visibility
                > 0.3

                and

                right_ear.visibility
                > 0.3

            ):

                left_ear_point = (

                    int(
                        left_ear.x
                        *
                        window_width
                    ),

                    int(
                        left_ear.y
                        *
                        window_height
                    )

                )


                right_ear_point = (

                    int(
                        right_ear.x
                        *
                        window_width
                    ),

                    int(
                        right_ear.y
                        *
                        window_height
                    )

                )


                ear_center = (

                    int(

                        (
                            left_ear_point[0]
                            +
                            right_ear_point[0]
                        )
                        /
                        2

                    ),

                    int(

                        (
                            left_ear_point[1]
                            +
                            right_ear_point[1]
                        )
                        /
                        2

                    )

                )


                neck_y = int(

                    ear_center[1]
                    *
                    0.35

                    +

                    shoulder_center[1]
                    *
                    0.65

                )

            else:

                neck_y = int(

                    shoulder_center[1]

                    -

                    shoulder_width
                    *
                    0.15

                )


            neck_x = shoulder_center[0]


            # ------------------------------------------------
            # CLOTHING
            # ------------------------------------------------

            cloth_name, cloth_original, cloth_path = clothes[
                current_cloth
            ]


            cloth = prepare_cloth(
                cloth_original.copy()
            )


            cloth_width = int(

                shoulder_width
                *
                1.75

            )


            cloth = resize_cloth(

                cloth,

                cloth_width

            )


            cloth_x = int(

                neck_x
                -
                cloth.shape[1]
                /
                2

            )


            cloth_y = int(

                neck_y

                -

                shoulder_width
                *
                0.05

            )


            frame = overlay_transparent(

                frame,

                cloth,

                cloth_x,

                cloth_y

            )


            cv2.putText(

                frame,

                "BODY DETECTED",

                (20, 40),

                cv2.FONT_HERSHEY_SIMPLEX,

                0.8,

                (0, 255, 0),

                2

            )


            text = (

                f"{current_cloth + 1}/"
                f"{len(clothes)} "
                f"{cloth_name}"

            )


            cv2.putText(

                frame,

                text,

                (20, 75),

                cv2.FONT_HERSHEY_SIMPLEX,

                0.6,

                (255, 255, 255),

                2

            )


            if show_landmarks:

                mp_draw.draw_landmarks(

                    frame,

                    results.pose_landmarks,

                    mp_pose.POSE_CONNECTIONS

                )


        else:

            cv2.putText(

                frame,

                "BODY NOT CLEAR",

                (20, 40),

                cv2.FONT_HERSHEY_SIMPLEX,

                0.8,

                (0, 0, 255),

                2

            )

    else:

        cv2.putText(

            frame,

            "NO BODY DETECTED",

            (20, 40),

            cv2.FONT_HERSHEY_SIMPLEX,

            0.8,

            (0, 0, 255),

            2

        )


    # ========================================================
    # TAKE PHOTO
    # ========================================================

    if take_photo:

        timestamp = datetime.now().strftime(
            "%Y-%m-%d_%H-%M-%S"
        )


        filename = (
            f"original_model_{timestamp}.jpg"
        )


        path = (
            PHOTO_FOLDER
            /
            filename
        )


        # IMPORTANT:
        # save raw camera photo only
        # no virtual clothing
        # no buttons
        # no tracking
        cv2.imwrite(

            str(path),

            model_photo,

            [
                cv2.IMWRITE_JPEG_QUALITY,
                95
            ]

