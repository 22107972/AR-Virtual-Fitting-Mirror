def find_last_original_photo():

    files = []

    for filename in os.listdir(
        PHOTO_FOLDER
    ):

        if (

            filename.startswith(
                "original_model_"
            )

            and

            filename.lower().endswith(
                ".jpg"
            )

        ):

            path = (
                PHOTO_FOLDER
                /
                filename
            )

            files.append(
                str(path)
            )

    if not files:

        return None

    files.sort(
        key=os.path.getmtime,
        reverse=True
    )

    return files[0]


# ============================================================
# NETWORK / CURRENT MAC IP
# ============================================================

def get_local_ip():

    try:

        route_output = subprocess.check_output(

            [
                "/sbin/route",
                "-n",
                "get",
                "default"
            ],

            text=True

        )

        interface = None

        for line in route_output.splitlines():

            line = line.strip()

            if line.startswith(
                "interface:"
            ):

                interface = (
                    line
                    .split(
                        ":",
                        1
                    )[1]
                    .strip()
                )

                break

        if interface:

            ip = subprocess.check_output(

                [
                    "/usr/sbin/ipconfig",
                    "getifaddr",
                    interface
                ],

                text=True

            ).strip()

            if ip:

                return ip

    except Exception:
        pass


    # Wi-Fi fallback
    try:

        ip = subprocess.check_output(

            [
                "/usr/sbin/ipconfig",
                "getifaddr",
                "en0"
            ],

            text=True

        ).strip()

        if ip:

            return ip

    except Exception:
        pass


    return "127.0.0.1"


# ============================================================
# QR CODE
# ============================================================

def create_qr(filename):

    ip = get_local_ip()

    url = (

        f"http://{ip}:5000/"
        f"results/{filename}"

    )

    print("")
    print("================================")
    print("QR LINK:")
    print(url)
    print("================================")
    print("")

    qr = qrcode.QRCode(

        version=1,

        box_size=8,

        border=3

    )

    qr.add_data(url)

    qr.make(
        fit=True
    )

    qr_image = qr.make_image()

    qr_image = qr_image.resize(
        (350, 350)
    )

    qr_image = np.array(
        qr_image.convert(
            "RGB"
        )
    )

    qr_image = cv2.cvtColor(
        qr_image,
        cv2.COLOR_RGB2BGR
    )

    cv2.namedWindow(
        "QR CODE - SCAN WITH PHONE",
        cv2.WINDOW_NORMAL
    )

    cv2.resizeWindow(
        "QR CODE - SCAN WITH PHONE",
        380,
        380
    )

    cv2.imshow(
        "QR CODE - SCAN WITH PHONE",
        qr_image
    )

    cv2.waitKey(1)


# ============================================================
# SHOW FASHN RESULT
# ============================================================

def show_fashn_result(
    result_path
):

    result_image = cv2.imread(
        result_path
    )

    if result_image is None:

        print(
            "ERROR: Could not open FASHN result."
        )

        return


    # Get original result size
    result_h, result_w = (
        result_image.shape[:2]
    )


    # Window size
    max_width = 900
    max_height = 700


    scale = min(

        max_width / result_w,

        max_height / result_h,

        1.0

    )


    display_width = int(
        result_w * scale
    )

    display_height = int(
        result_h * scale
    )


    if scale < 1.0:

        display_image = cv2.resize(

            result_image,

            (
                display_width,
                display_height
            ),

            interpolation=cv2.INTER_AREA

        )

    else:

        display_image = result_image


    cv2.namedWindow(
        "FASHN RESULT",
        cv2.WINDOW_NORMAL
    )

    cv2.resizeWindow(

        "FASHN RESULT",

        display_width,

        display_height

    )

    cv2.imshow(
        "FASHN RESULT",
        display_image
    )

    cv2.waitKey(1)


# ============================================================
# BASE64
# ============================================================

def image_to_base64(
    filename
):

    with open(
        filename,
        "rb"
    ) as file:

        data = base64.b64encode(
            file.read()
        ).decode(
            "utf-8"
        )


    if filename.lower().endswith(
        ".png"
    ):

        mime = "image/png"

    else:

        mime = "image/jpeg"


    return (
        f"data:{mime};base64,{data}"
    )


# ============================================================
# PERMANENT CACHE
# ============================================================

def get_cache_filename(

    model_path,

    garment_path

):

    hash_object = hashlib.sha256()


    with open(
        model_path,
        "rb"
    ) as f:

        hash_object.update(
            f.read()
        )


    with open(
        garment_path,
        "rb"
    ) as f:

        hash_object.update(
            f.read()
        )


    key = hash_object.hexdigest()[:20]


    return os.path.join(

        str(RESULT_FOLDER),

        f"tryon_{key}.jpg"

    )


